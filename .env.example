# Copy to .env.local and fill in what you need. Every value below is the
# built-in default, so an empty file behaves identically to this one.
#
# .env is read first, then .env.local overrides it. Only .env.example is
# committed; both of the others are gitignored.

# --- storage ---------------------------------------------------------------
# Directory holding the persistent Chroma collection. Derived from the corpus,
# so it is safe to delete — you pay a re-ingest, not a restore.
CHROMA_PATH=.chroma

# --- embeddings ------------------------------------------------------------
# Any sentence-transformers model id. Runs locally, which is what makes the
# evaluation sweeps in phases 12-15 free to re-run.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- generation ------------------------------------------------------------
# Free key from https://console.groq.com. Leaving it blank is supported:
# ingestion and retrieval work as normal and only answer generation is
# unavailable. Never commit a filled-in key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- chunking --------------------------------------------------------------
# Characters, not tokens. CHUNK_OVERLAP must be smaller than CHUNK_SIZE or the
# service refuses to start.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- retrieval -------------------------------------------------------------
# Passages fetched per query before generation sees them.
TOP_K=5

# --- logging ---------------------------------------------------------------
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
